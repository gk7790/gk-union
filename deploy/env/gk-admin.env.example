# GK Union Admin production environment.
# Copy to /opt/gk-admin/config/gk-admin.env and replace all placeholder values.

SPRING_PROFILES_ACTIVE=prod
APP_NAME=gk-admin
SERVER_PORT=8081
TZ=UTC
APP_TIME_ZONE=UTC

JAVA_OPTS="-Xms512m -Xmx512m -XX:+UseG1GC -Dfile.encoding=UTF-8 -Duser.timezone=UTC"

DB_URL=jdbc:postgresql://your-postgresql-endpoint:5432/gk_union
DB_USERNAME=gk_user
DB_PASSWORD=change-me
DB_POOL_NAME=gk-admin-hikari
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=30000
DB_VALIDATION_TIMEOUT=5000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
REDIS_TIMEOUT=6000ms
REDIS_CONNECT_TIMEOUT=6000ms
REDIS_POOL_MAX_ACTIVE=64
REDIS_POOL_MAX_WAIT=1000ms
REDIS_POOL_MAX_IDLE=16
REDIS_POOL_MIN_IDLE=2

LOG_HOME=/data/logs/gk-admin
LOG_FILE=/data/logs/gk-admin/gk-admin.log
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_GK=INFO
LOG_LEVEL_SPRING=WARN
LOG_MAX_FILE_SIZE=100MB
LOG_MAX_HISTORY=30
LOG_TOTAL_SIZE_CAP=10GB

LIFECYCLE_ALERT_ENABLED=true
SHUTDOWN_TIMEOUT=30s
TOMCAT_CONNECTION_TIMEOUT=20000
TOMCAT_THREADS_MAX=80
TOMCAT_THREADS_MIN_SPARE=10
TOMCAT_ACCEPT_COUNT=100
TOMCAT_MAX_KEEP_ALIVE_REQUESTS=100
UPLOAD_MAX_FILE_SIZE=50MB
UPLOAD_MAX_REQUEST_SIZE=50MB
QUARTZ_THREAD_COUNT=8

PSP_CALLBACK_BASE_URL=https://api.example.com
KNIFE4J_USERNAME=admin
KNIFE4J_PASSWORD=change-me
