# GK Union Open API production environment.
# Copy to /opt/gk-api/config/gk-api.env and replace all placeholder values.

SPRING_PROFILES_ACTIVE=prod
APP_NAME=gk-api
SERVER_PORT=8082
TZ=UTC
APP_TIME_ZONE=UTC

JAVA_OPTS="-Xms768m -Xmx768m -XX:+UseG1GC -Dfile.encoding=UTF-8 -Duser.timezone=UTC"

DB_URL=jdbc:mysql://your-rds-endpoint:3306/gk_union?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=gk_user
DB_PASSWORD=change-me
DB_POOL_NAME=gk-api-hikari
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT=30000
DB_VALIDATION_TIMEOUT=5000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
REDIS_TIMEOUT=6000ms
REDIS_CONNECT_TIMEOUT=6000ms
REDIS_POOL_MAX_ACTIVE=64
REDIS_POOL_MAX_WAIT=1000ms
REDIS_POOL_MAX_IDLE=16
REDIS_POOL_MIN_IDLE=2

LOG_HOME=/data/logs/gk-api
LOG_FILE=/data/logs/gk-api/gk-api.log
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_GK=INFO
LOG_LEVEL_SPRING=WARN
LOG_MAX_FILE_SIZE=100MB
LOG_MAX_HISTORY=30
LOG_TOTAL_SIZE_CAP=10GB

LIFECYCLE_ALERT_ENABLED=true
SHUTDOWN_TIMEOUT=30s
TOMCAT_CONNECTION_TIMEOUT=20000
TOMCAT_THREADS_MAX=120
TOMCAT_THREADS_MIN_SPARE=10
TOMCAT_ACCEPT_COUNT=200
TOMCAT_MAX_KEEP_ALIVE_REQUESTS=100
UPLOAD_MAX_FILE_SIZE=50MB
UPLOAD_MAX_REQUEST_SIZE=50MB

PSP_CALLBACK_BASE_URL=https://api.example.com
MERCHANT_DEFAULT_TIMEZONE=UTC
MERCHANT_DEFAULT_LANG=zh-CN
MERCHANT_DEFAULT_COUNTRY_CODE=PH
MERCHANT_DEFAULT_CONFIG_JSON={}
