<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gk.iam.dao.SysDeptDao">

	<select id="getList" resultType="com.gk.iam.entity.SysDeptEntity">
		select t1.* from sys_dept t1
		<where>
			<if test="tenantId != null">
				t1.tenant_id = #{tenantId}
			</if>
			<if test="deptIdList != null">
				<if test="tenantId != null">
					and
				</if>
				t1.id in
				<foreach item="id" collection="deptIdList" open="(" separator="," close=")">
					#{id}
				</foreach>
			</if>
		</where>
		order by t1.sort asc
	</select>

	<select id="getById" resultType="com.gk.iam.entity.SysDeptEntity">
		select t1.* from sys_dept t1
		where t1.id = #{value}
	</select>

	<select id="getIdAndPidList" resultType="com.gk.iam.entity.SysDeptEntity">
		select t1.id, t1.pid from sys_dept t1
	</select>

</mapper>