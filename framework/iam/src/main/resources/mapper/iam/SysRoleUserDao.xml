<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gk.iam.dao.SysRoleUserDao">

    <delete id="deleteByRoleIds">
        delete from sys_role_user where role_id in
        <foreach item="roleId" collection="array" open="(" separator="," close=")">
            #{roleId}
        </foreach>
    </delete>

    <delete id="deleteByUserIds">
        delete from sys_role_user where user_id in
        <foreach item="userId" collection="array" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </delete>

    <delete id="deleteByUserSubjectIds">
        delete from sys_role_user where user_subject_id in
        <foreach item="userSubjectId" collection="array" open="(" separator="," close=")">
            #{userSubjectId}
        </foreach>
    </delete>

    <select id="getRoleIdListBySubjectId" resultType="long">
        select role_id from sys_role_user where user_subject_id = #{value}
    </select>

</mapper>
