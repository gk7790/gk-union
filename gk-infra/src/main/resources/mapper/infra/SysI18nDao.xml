<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gk.infra.i18n.dao.SysI18nDao">

    <resultMap type="com.gk.infra.i18n.entity.SysI18nEntity" id="sysI18nMap">
        <result property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="bizType" column="biz_type"/>
        <result property="bizId" column="biz_id"/>
        <result property="i18nKey" column="i18n_key"/>
        <result property="lang" column="lang"/>
        <result property="value" column="value"/>
        <result property="createdBy" column="created_by"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedBy" column="updated_by"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectByLang" resultType="com.gk.infra.i18n.entity.SysI18nEntity">
        SELECT * FROM sys_i18n WHERE lang = #{lang}
    </select>

    <select id="selectByTypeAndLang" resultType="com.gk.infra.i18n.entity.SysI18nEntity">
        SELECT * FROM sys_i18n WHERE biz_type = #{type} AND lang = #{lang}
    </select>

    <select id="getPageList" resultType="com.gk.infra.i18n.entity.SysI18nEntity">
        SELECT t1.tenant_id, t1.biz_type, t1.biz_id, t1.i18n_key, t1.lang, t1.`value` FROM sys_i18n t1
        INNER JOIN ( SELECT i18n_key, MAX(tenant_id) AS max_tenant_id
            FROM sys_i18n
            WHERE lang = #{lang}
            AND tenant_id IN (0, #{tenantId})
            <if test="i18nKey != null and i18nKey.trim() != ''">
                AND i18n_key like concat("%", #{i18nKey}, "%")
            </if>
            GROUP BY i18n_key
        ) t2 ON t1.i18n_key = t2.i18n_key
        AND t1.tenant_id = t2.max_tenant_id
        AND t1.lang = #{lang}
        <if test="i18nKey != null and i18nKey.trim() != ''">
            AND t1.i18n_key like concat("%", #{i18nKey}, "%")
        </if>
    </select>

    <select id="getList" resultType="com.gk.infra.i18n.entity.SysI18nEntity">
        SELECT * FROM sys_i18n i
        <where>
            <if test="tenantId != null">
                and i.tenant_id = #{tenantId}
            </if>
            <if test="bizType != null and bizType.trim() != ''">
                and i.biz_type = #{bizType}
            </if>
            <if test="i18nKey != null and i18nKey.trim() != ''">
                and i.i18n_key = #{i18nKey}
            </if>
        </where>
    </select>

</mapper>