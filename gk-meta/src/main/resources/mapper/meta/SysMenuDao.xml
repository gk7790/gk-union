<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gk.meta.dao.SysMenuDao">

    <resultMap id="SysMenuResultMap" type="com.gk.meta.entity.SysMenuEntity">
        <id property="id" column="id"/>
        <result property="pid" column="pid"/>
        <result property="name" column="name"/>
        <result property="path" column="path"/>
        <result property="type" column="type"/>
        <result property="status" column="status"/>
        <result property="activePath" column="active_path"/>
        <result property="authCode" column="auth_code"/>
        <result property="component" column="component"/>
        <result property="sort" column="sort"/>
        <result property="subjectTypes" column="subject_types" typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="domain" column="domain" typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="meta" property="meta" typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
    </resultMap>

    <sql id="subjectTypeFilter">
        <if test="subjectType != null and subjectType != ''">
            and t1.subject_types is not null
            and json_valid(t1.subject_types)
            and json_contains(t1.subject_types, json_quote(#{subjectType}))
        </if>
    </sql>

    <sql id="typeListFilter">
        <if test="typeList != null">
            and t1.type in
            <foreach item="type" collection="typeList" open="(" separator="," close=")">
                #{type}
            </foreach>
        </if>
    </sql>

	<select id="getById" resultType="com.gk.meta.entity.SysMenuEntity">
		select t1.* from sys_menu t1
		where t1.id = #{id}
	</select>

	<select id="getCatalogMenuList" resultMap="SysMenuResultMap">
		select t1.* from sys_menu t1
		<where>
            t1.id &gt; #{minId}
            <include refid="typeListFilter"/>
            <include refid="subjectTypeFilter"/>
		</where>
		order by t1.sort asc
	</select>

	<select id="getNavMenuList" resultMap="SysMenuResultMap">
		select distinct t3.* from sys_user_subject t1
		inner join sys_role_menu t2 on t1.role_id = t2.role_id
		inner join sys_menu t3 on t2.menu_id = t3.id
		where t3.id &gt; #{minId}
          and t1.user_id = #{userId}
          and t1.role_id = #{roleId}
        <if test="typeList != null">
            and t3.type in
            <foreach item="type" collection="typeList" open="(" separator="," close=")">
                #{type}
            </foreach>
        </if>
        <if test="subjectType != null and subjectType != ''">
            and t3.subject_types is not null
            and json_valid(t3.subject_types)
            and json_contains(t3.subject_types, json_quote(#{subjectType}))
        </if>
		order by t3.sort asc
	</select>

    <select id="countMenusNotInSubjectType" resultType="long">
        select count(1) from sys_menu
        where id in
        <foreach item="menuId" collection="menuIds" open="(" separator="," close=")">
            #{menuId}
        </foreach>
        and (
            subject_types is null
            or not json_valid(subject_types)
            or not json_contains(subject_types, json_quote(#{subjectType}))
        )
    </select>

	<select id="getListPid" resultType="com.gk.meta.entity.SysMenuEntity">
		select * from sys_menu where pid = #{value}
	</select>

</mapper>
