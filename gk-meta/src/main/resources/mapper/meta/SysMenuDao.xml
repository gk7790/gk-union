<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gk.meta.dao.SysMenuDao">

    <resultMap id="SysMenuResultMap" type="com.gk.meta.entity.SysMenuEntity">
        <id property="id" column="id"/>
        <result property="pid" column="pid"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="name" column="name"/>
        <result property="path" column="path"/>
        <result property="type" column="type"/>
        <result property="status" column="status"/>
        <result property="activePath" column="active_path"/>
        <result property="authCode" column="auth_code"/>
        <result property="component" column="component"/>
        <result property="sort" column="sort"/>
        <result property="scope" column="scope"/>
        <result property="domain" column="domain"/>
        <result column="meta" property="meta" typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
    </resultMap>

	<select id="getById" resultType="com.gk.meta.entity.SysMenuEntity">
		select t1.* from sys_menu t1
		where t1.id = #{id}
	</select>

	<select id="getMenuList" resultMap="SysMenuResultMap">
		select t1.*	from sys_menu t1
		<where>
            <if test="typeList != null">
                and t1.type in
                <foreach item="type" collection="typeList" open="(" separator="," close=")">
                    #{type}
                </foreach>
            </if>
            <if test="scope != null and scope.trim() != ''">
                AND t1.scope = #{scope}
            </if>
            <if test="domain != null and domain.trim() != ''">
                AND t1.domain = #{domain}
            </if>
		</where>
		order by t1.sort asc
	</select>

	<select id="getUserMenuList" resultMap="SysMenuResultMap">
		select t3.* from sys_role_user t1
		left join sys_role_menu t2 on t1.role_id = t2.role_id
		left join sys_menu t3 on t2.menu_id = t3.id
		where t1.user_id = #{userId}
        <if test="typeList != null">
            and t3.type in
            <foreach item="type" collection="typeList" open="(" separator="," close=")">
                #{type}
            </foreach>
        </if>
        <if test="scope != null and scope.trim() != ''">
            AND t3.scope = #{scope}
        </if>
        <if test="domain != null and domain.trim() != ''">
            AND t3.domain = #{domain}
        </if>
		order by t3.sort asc
	</select>

	<select id="getListPid" resultType="com.gk.meta.entity.SysMenuEntity">
		select * from sys_menu where pid = #{value}
	</select>
	
</mapper>