<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gk.meta.dao.SysCurrencyDao">
    <resultMap id="SysCurrencyOptionMap" type="com.gk.meta.dto.SysCurrencyDTO">
        <id property="currency" column="currency"/>
        <collection property="tenantIds" javaType="java.util.ArrayList" ofType="java.lang.Long" notNullColumn="tenant_id">
            <result column="tenant_id"/>
        </collection>
    </resultMap>

    <select id="selectOptions" resultMap="SysCurrencyOptionMap">
        SELECT DISTINCT
            c.currency AS currency,
            CASE
                WHEN #{tenantId} IS NULL THEN c.sort
                ELSE COALESCE(tc.sort, c.sort)
            END AS sort,
            tc.tenant_id AS tenant_id
        FROM sys_currency c
        LEFT JOIN sys_tenant_currency tc
          ON tc.currency = c.currency
         AND tc.status IN
        <foreach collection="statusList" item="status" open="(" separator="," close=")">
            #{status}
        </foreach>
        <if test="tenantId != null">
         AND tc.tenant_id = #{tenantId}
        </if>
        WHERE c.status IN
        <foreach collection="statusList" item="status" open="(" separator="," close=")">
            #{status}
        </foreach>
        <if test="tenantId != null">
          AND tc.tenant_id IS NOT NULL
        </if>
        ORDER BY sort ASC, c.currency ASC, tc.tenant_id ASC
    </select>
</mapper>
