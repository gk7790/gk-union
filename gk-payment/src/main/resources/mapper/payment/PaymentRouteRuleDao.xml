<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gk.payment.dao.PaymentRouteRuleDao">
    <!--suppress ALL, MybatisXMapperXmlInspection, MyBatisXmlInspection, XmlUnresolvedReference -->
    <sql id="pageWithNameWhere">
        <where>
            <if test="tenantId != null">
                AND r.tenant_id = #{tenantId}
            </if>
            <if test="merchantId != null">
                AND r.merchant_id = #{merchantId}
            </if>
            <if test="merchantAppId != null">
                AND r.merchant_app_id = #{merchantAppId}
            </if>
            <if test="groupId != null">
                AND r.group_id = #{groupId}
            </if>
            <if test="status != null">
                AND r.status = #{status}
            </if>
            <if test="ruleName != null and ruleName != ''">
                AND r.rule_name LIKE CONCAT('%', #{ruleName}, '%')
            </if>
            <if test="direction != null and direction != ''">
                AND r.direction = #{direction}
            </if>
            <if test="countryCode != null and countryCode != ''">
                AND r.country_code = #{countryCode}
            </if>
            <if test="currency != null and currency != ''">
                AND r.currency = #{currency}
            </if>
            <if test="methodCode != null and methodCode != ''">
                AND r.method_code = #{methodCode}
            </if>
            <if test="merchantName != null and merchantName != ''">
                AND m.merchant_name LIKE CONCAT('%', #{merchantName}, '%')
            </if>
            <if test="merchantAppName != null and merchantAppName != ''">
                AND a.app_name LIKE CONCAT('%', #{merchantAppName}, '%')
            </if>
        </where>
    </sql>

    <select id="countPageWithName" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM payment_route_rule r
        LEFT JOIN merchant m
          ON m.tenant_id = r.tenant_id
         AND m.id = r.merchant_id
        LEFT JOIN merchant_app a
          ON a.tenant_id = r.tenant_id
         AND a.id = r.merchant_app_id
        <include refid="pageWithNameWhere"/>
    </select>

    <!--suppress ALL, MybatisXMapperXmlInspection, MyBatisXmlInspection, XmlUnresolvedReference -->
    <select id="selectPageWithName" resultType="com.gk.payment.dto.PaymentRouteRuleDTO">
        SELECT
            r.id AS id,
            r.tenant_id AS tenantId,
            r.rule_name AS ruleName,
            r.merchant_id AS merchantId,
            m.merchant_short_name AS merchantName,
            r.merchant_app_id AS merchantAppId,
            a.app_name AS merchantAppName,
            r.direction AS direction,
            r.country_code AS countryCode,
            r.currency AS currency,
            r.method_code AS methodCode,
            r.min_amount AS minAmount,
            r.max_amount AS maxAmount,
            r.group_id AS groupId,
            r.priority AS priority,
            r.effective_at AS effectiveAt,
            r.expire_at AS expireAt,
            r.status AS status,
            r.remark AS remark,
            r.created_by AS createdBy,
            r.created_at AS createdAt,
            r.updated_by AS updatedBy,
            r.updated_at AS updatedAt
        FROM payment_route_rule r
        LEFT JOIN merchant m
          ON m.tenant_id = r.tenant_id
         AND m.id = r.merchant_id
        LEFT JOIN merchant_app a
          ON a.tenant_id = r.tenant_id
         AND a.id = r.merchant_app_id
        <include refid="pageWithNameWhere"/>
        ORDER BY r.id DESC
        LIMIT #{limitValue} OFFSET #{offset}
    </select>
</mapper>
