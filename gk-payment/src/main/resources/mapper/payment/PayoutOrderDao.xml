<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gk.payment.dao.PayoutOrderDao">

    <!--suppress ALL, MybatisXMapperXmlInspection, MyBatisXmlInspection, XmlUnresolvedReference -->
    <sql id="pageWithNameWhere">
        <where>
            <if test="tenantId != null">
                AND r.tenant_id = #{tenantId}
            </if>
            <if test="merchantId != null">
                AND r.merchant_id = #{merchantId}
            </if>
            <if test="merchantAppId != null">
                AND r.merchant_app_id = #{merchantAppId}
            </if>
            <if test="pspId != null">
                AND r.psp_id = #{pspId}
            </if>
            <if test="merchantFeeRuleId != null">
                AND r.merchant_fee_rule_id = #{merchantFeeRuleId}
            </if>
            <if test="pspFeeRuleId != null">
                AND r.psp_fee_rule_id = #{pspFeeRuleId}
            </if>
            <if test="payoutOrderNo != null and payoutOrderNo != ''">
                AND r.payout_order_no = #{payoutOrderNo}
            </if>
            <if test="merchantOrderNo != null and merchantOrderNo != ''">
                AND r.merchant_order_no = #{merchantOrderNo}
            </if>
            <if test="idempotencyKey != null and idempotencyKey != ''">
                AND r.idempotency_key = #{idempotencyKey}
            </if>
            <if test="requestId != null and requestId != ''">
                AND r.request_id = #{requestId}
            </if>
            <if test="status != null and status != ''">
                AND r.status = #{status}
            </if>
            <if test="merchantNotifyStatus != null and merchantNotifyStatus != ''">
                AND r.merchant_notify_status = #{merchantNotifyStatus}
            </if>
            <if test="countryCode != null and countryCode != ''">
                AND r.country_code = #{countryCode}
            </if>
            <if test="currency != null and currency != ''">
                AND r.currency = #{currency}
            </if>
            <if test="methodCode != null and methodCode != ''">
                AND r.method_code = #{methodCode}
            </if>
            <if test="pspCode != null and pspCode != ''">
                AND r.psp_code = #{pspCode}
            </if>
            <if test="pspOrderNo != null and pspOrderNo != ''">
                AND r.psp_order_no = #{pspOrderNo}
            </if>
            <if test="pspRequestNo != null and pspRequestNo != ''">
                AND r.psp_request_no = #{pspRequestNo}
            </if>
            <if test="holdNo != null and holdNo != ''">
                AND r.hold_no = #{holdNo}
            </if>
            <if test="payeeAccountNo != null and payeeAccountNo != ''">
                AND r.payee_account_no = #{payeeAccountNo}
            </if>
            <if test="merchantName != null and merchantName != ''">
                AND m.merchant_name LIKE CONCAT('%', #{merchantName}, '%')
            </if>
            <if test="merchantAppName != null and merchantAppName != ''">
                AND a.app_name LIKE CONCAT('%', #{merchantAppName}, '%')
            </if>
        </where>
    </sql>

    <select id="countPageWithName" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM payout_order r
        LEFT JOIN merchant m
          ON m.tenant_id = r.tenant_id
         AND m.id = r.merchant_id
        LEFT JOIN merchant_app a
          ON a.tenant_id = r.tenant_id
         AND a.id = r.merchant_app_id
        <include refid="pageWithNameWhere"/>
    </select>

    <!--suppress ALL, MybatisXMapperXmlInspection, MyBatisXmlInspection, XmlUnresolvedReference -->
    <select id="selectPageWithName" resultType="com.gk.payment.dto.PayoutOrderDTO">
        SELECT
            r.*,
            <choose>
                <when test="showTenantName == true">
            t.name AS tenantName,
                </when>
                <otherwise>
            NULL AS tenantName,
                </otherwise>
            </choose>
            <choose>
                <when test="showMerchantName == true">
            m.merchant_short_name AS merchantName,
                </when>
                <otherwise>
            NULL AS merchantName,
                </otherwise>
            </choose>
            a.app_name AS merchantAppName
        FROM payout_order r
        LEFT JOIN merchant m
          ON m.tenant_id = r.tenant_id
         AND m.id = r.merchant_id
        LEFT JOIN merchant_app a
          ON a.tenant_id = r.tenant_id
         AND a.id = r.merchant_app_id
        <if test="showTenantName == true">
        LEFT JOIN sys_tenant t
          ON t.id = r.tenant_id
        </if>
        <include refid="pageWithNameWhere"/>
        ORDER BY r.id DESC
        LIMIT #{limitValue} OFFSET #{offset}
    </select>

    <sql id="OpenApiColumns">
        id, tenant_id, merchant_id, merchant_no, merchant_app_id, app_id,
        payout_order_no, merchant_order_no, idempotency_key, request_id, order_source,
        country_code, currency, method_code, amount, merchant_fee_amount,
        merchant_fee_rule_id, total_debit_amount, psp_fee_amount, psp_fee_rule_id,
        payee_name, payee_account_no, payee_bank_code, payee_wallet_type,
        payee_phone, payee_email, notify_url, merchant_notify_status,
        merchant_notify_at, merchant_notify_task_id, status, status_reason,
        merchant_status_code, merchant_status_reason,
        submitted_at, completed_at, failed_at, cancelled_at, fail_code, fail_msg,
        hold_no, freeze_journal_no, success_journal_no, release_journal_no,
        payment_plan_catalog_id, payment_plan_version, payment_plan_bucket_id,
        payment_plan_route_option_id, route_rule_id, route_group_id, route_channel_id,
        psp_id, psp_code, psp_method_id, psp_method_code, psp_account_id,
        psp_account_no, psp_request_no, psp_order_no, psp_status, psp_raw_status,
        next_query_at, query_count, outbox_event_id, version, remark,
        updated_by, updated_at, created_by, created_at
    </sql>

    <select id="selectOpenApiByMerchantOrderNo"
            resultType="com.gk.payment.entity.PayoutOrderEntity">
        SELECT
        <include refid="OpenApiColumns"/>
        FROM payout_order
        WHERE tenant_id = #{tenantId}
          AND merchant_id = #{merchantId}
          AND merchant_order_no = #{merchantOrderNo}
        LIMIT 1
    </select>

    <select id="selectOpenApiByPayoutOrderNo"
            resultType="com.gk.payment.entity.PayoutOrderEntity">
        SELECT
        <include refid="OpenApiColumns"/>
        FROM payout_order
        WHERE tenant_id = #{tenantId}
          AND merchant_id = #{merchantId}
          AND payout_order_no = #{payoutOrderNo}
        LIMIT 1
    </select>

</mapper>
